                                <Button x:Name="btnShufflePlaylist" Content="&#xE72A;" ToolTip="{Binding [TooltipShuffle], Source={x:Static i18n:I18nService.Instance}}" FontFamily="Segoe MDL2 Assets" Style="{StaticResource TransportBtn}" FontSize="14" Click="BtnShufflePlaylist_Click" Margin="0,0,4,0"/>
                                <Button x:Name="btnRepeatMode" Content="&#xE8EE;" ToolTip="{Binding [ToolTipRepeatAll], Source={x:Static i18n:I18nService.Instance}}" FontFamily="Segoe MDL2 Assets" Style="{StaticResource TransportBtn}" FontSize="14" Click="BtnRepeatMode_Click" Margin="0,0,4,0"/>
                                <Button x:Name="btnSortPlaylist" Content="&#xE8CB;" ToolTip="{Binding [TooltipSort], Source={x:Static i18n:I18nService.Instance}}" FontFamily="Segoe MDL2 Assets" Style="{StaticResource TransportBtn}" FontSize="14" Click="BtnSortPlaylist_Click" Margin="0,0,4,0">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="menuSort" Style="{StaticResource SmartFillContextMenuStyle}">
                                            <MenuItem x:Name="menuSortNameAsc"  Header="{Binding [SortNameAsc], Source={x:Static i18n:I18nService.Instance}}" Tag="NameAscending"  Click="SortMenuItem_Click" IsCheckable="True" IsChecked="False" Style="{StaticResource SmartFillMenuItemStyle}"/>
                                            <MenuItem x:Name="menuSortNameDesc" Header="{Binding [SortNameDesc], Source={x:Static i18n:I18nService.Instance}}" Tag="NameDescending" Click="SortMenuItem_Click" IsCheckable="True" IsChecked="False" Style="{StaticResource SmartFillMenuItemStyle}"/>
                                            <MenuItem x:Name="menuSortDateDesc" Header="{Binding [SortDateDesc], Source={x:Static i18n:I18nService.Instance}}" Tag="DateDescending" Click="SortMenuItem_Click" IsCheckable="True" IsChecked="False" Style="{StaticResource SmartFillMenuItemStyle}"/>
                                            <MenuItem x:Name="menuSortDateAsc"  Header="{Binding [SortDateAsc], Source={x:Static i18n:I18nService.Instance}}" Tag="DateAscending"  Click="SortMenuItem_Click" IsCheckable="True" IsChecked="False" Style="{StaticResource SmartFillMenuItemStyle}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button x:Name="btnClearPlaylist" Content="&#xE74D;" ToolTip="{Binding [TooltipClearPlaylist], Source={x:Static i18n:I18nService.Instance}}" FontFamily="Segoe MDL2 Assets" Style="{StaticResource TransportBtn}" FontSize="14" Click="BtnClearPlaylist_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ListBox x:Name="lbPlaylist" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,2,0,8"
                             Foreground="#CCCCCC" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             PreviewMouseWheel="LbPlaylist_PreviewMouseWheel"
                             PreviewMouseLeftButtonDown="LbPlaylist_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="LbPlaylist_PreviewMouseMove"
                             AllowDrop="True" DragOver="LbPlaylist_DragOver" Drop="PlaylistDrawer_Drop"
                             SelectionChanged="LbPlaylist_SelectionChanged" MouseDoubleClick="LbPlaylist_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="16,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#20FFFFFF"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#20FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeSelectedItemBgBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE103;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource ThemeAccentBrush}" 
                                               VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"
                                               Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" 
                                               VerticalAlignment="Center" ToolTip="{Binding FilePath}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" 
                                            Background="Transparent" BorderThickness="0" FontSize="12" Padding="6,2"
                                            Cursor="Hand" Click="BtnDeletePlaylistItem_Click"
                                            x:Name="btnDelete" Visibility="Hidden">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                                                <Setter Property="Opacity" Value="0.85"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent">
                                                                <TextBlock Text="{TemplateBinding Content}" 
                                                                           FontFamily="{TemplateBinding FontFamily}" 
                                                                           FontSize="{TemplateBinding FontSize}" 
                                                                           Foreground="{TemplateBinding Foreground}" 
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeButtonHoverFgBrush}"/>
                                                                    <Setter Property="Opacity" Value="1.0"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                        <Setter TargetName="btnDelete" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
        </Popup>

        <!-- Playlist Overlay Popup (Modal) -->
        <Popup x:Name="popupLibrary" PlacementTarget="{Binding ElementName=mainGrid}"
               Placement="Center" AllowsTransparency="True" StaysOpen="True" Opened="Popup_Opened">
            <Grid x:Name="gridLibraryHost" 
                  Width="{Binding ElementName=mainGrid, Path=ActualWidth}"
                  Height="{Binding ElementName=mainGrid, Path=ActualHeight}">
                <views:PlaylistOverlay x:Name="overlayLibrary"/>
            </Grid>
        </Popup>

        <!-- Subtitle & Audio Tracks Overlay Popup -->
        <Popup x:Name="popupTracks" PlacementTarget="{Binding ElementName=btnTracks}" Placement="Top" StaysOpen="False" AllowsTransparency="True" VerticalOffset="-8" HorizontalOffset="-180" Opened="Popup_Opened">
            <views:TracksOverlay x:Name="overlayTracks"/>
        </Popup>

        <!-- Settings Overlay Popup (Modal) -->
        <Popup x:Name="popupSettings" PlacementTarget="{Binding ElementName=mainGrid}"
               Placement="Center" AllowsTransparency="True" StaysOpen="True" Opened="Popup_Opened">
            <Grid x:Name="gridSettingsHost" 
                  Width="{Binding ElementName=mainGrid, Path=ActualWidth}"
                  Height="{Binding ElementName=mainGrid, Path=ActualHeight}">
                <views:SettingsOverlay x:Name="overlaySettings"/>
            </Grid>
        </Popup>

        <!-- Open URL / Stream Overlay Popup (Modal) -->
        <Popup x:Name="popupOpenUrl" PlacementTarget="{Binding ElementName=mainGrid}"
               Placement="Center" AllowsTransparency="True" StaysOpen="True" Opened="Popup_Opened">
            <Grid x:Name="gridOpenUrlHost" 
                  Width="{Binding ElementName=mainGrid, Path=ActualWidth}"
                  Height="{Binding ElementName=mainGrid, Path=ActualHeight}">
                <views:OpenUrlOverlay x:Name="overlayOpenUrl"/>
            </Grid>
        </Popup>

        <!-- Sponsor / Donation Overlay Popup (Modal) -->
        <Popup x:Name="popupSponsor" PlacementTarget="{Binding ElementName=mainGrid}"
               Placement="Center" AllowsTransparency="True" StaysOpen="True" Opened="Popup_Opened">
            <Grid x:Name="gridSponsorHost" 
                  Width="{Binding ElementName=mainGrid, Path=ActualWidth}"
                  Height="{Binding ElementName=mainGrid, Path=ActualHeight}">
                <views:SponsorOverlay x:Name="overlaySponsor"/>
            </Grid>
        </Popup>

        <!-- Fade to Black Transition Popup -->
        <Popup x:Name="popupFade" PlacementTarget="{Binding ElementName=mainGrid}"
               Placement="Center" AllowsTransparency="True" StaysOpen="True" IsOpen="True">
            <Border x:Name="borderFade" Background="Black" Opacity="0" IsHitTestVisible="False"
                    Width="{Binding ElementName=mainGrid, Path=ActualWidth}"
                    Height="{Binding ElementName=mainGrid, Path=ActualHeight}"/>
        </Popup>

        </Grid>
    </Border>
</Window>
