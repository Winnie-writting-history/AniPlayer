                                <MenuItem x:Name="menuCropPreserveFS" Header="{Binding [CropPreserve], Source={x:Static i18n:I18nService.Instance}}" Tag="preserve" Click="AutoCropMenuItem_Click" IsCheckable="True" Style="{StaticResource SmartFillMenuItemStyle}"/>
                                <MenuItem x:Name="menuCropAllFS" Header="{Binding [CropAll], Source={x:Static i18n:I18nService.Instance}}" Tag="crop" Click="AutoCropMenuItem_Click" IsCheckable="True" Style="{StaticResource SmartFillMenuItemStyle}"/>
                            </ContextMenu>
