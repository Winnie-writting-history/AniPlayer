                    <Button x:Name="btnAutoCropFS" Content="&#xE7E6;" ToolTip="{Binding [TooltipAutoCrop], Source={x:Static i18n:I18nService.Instance}}" Style="{StaticResource TransportBtn}" Click="BtnAutoCrop_Click" Margin="0,0,10,0">
