                        <Popup x:Name="popupBrightnessFS" PlacementTarget="{Binding ElementName=btnBrightnessResetFS}" Placement="Top" StaysOpen="True" AllowsTransparency="True" VerticalOffset="-4" HorizontalOffset="-1">
                            <Border Background="{DynamicResource ThemeMenuBgBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="{DynamicResource ThemeBorderThickness}" CornerRadius="{DynamicResource ThemePanelCornerRadius}" Padding="0,10" Width="44" Height="140" MouseEnter="BrightnessFS_MouseEnter" MouseLeave="BrightnessFS_MouseLeave" MouseWheel="Brightness_MouseWheel">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="12" Opacity="0.5" Direction="270" ShadowDepth="3"/>
