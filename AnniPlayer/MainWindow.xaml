                    <Button x:Name="btnFullscreenFS" Content="&#xE73F;" ToolTip="{Binding [TooltipFullscreen], Source={x:Static i18n:I18nService.Instance}}" Style="{StaticResource TransportBtn}" Click="BtnFullscreen_Click" Margin="0,0,8,0"/>
