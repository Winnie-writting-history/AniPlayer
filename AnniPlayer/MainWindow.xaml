               Width="{Binding ActualWidth, ElementName=mainGrid}"
               AllowsTransparency="True" StaysOpen="True">
            <Grid x:Name="fsBottomBar" Height="118" HorizontalAlignment="Stretch" Width="{Binding ActualWidth, ElementName=mainGrid}" Background="{DynamicResource ThemeControlBarBrush}">
                 <Grid.RenderTransform>
                     <TranslateTransform x:Name="transBottomBar" Y="125"/>
                 </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="5"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="18"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource ThemeControlBarImageBrush}" IsHitTestVisible="False" Grid.RowSpan="4"/>
            <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource ThemeBorderBrush}" IsHitTestVisible="False" Grid.RowSpan="4"/>
            <Grid Grid.Row="1" Margin="20,-5,28,0">
                <Slider x:Name="sliderTimelineFS" Style="{StaticResource TimelineSlider}"
                        PreviewMouseDown="Timeline_PreviewMouseDown"
                        PreviewMouseUp="Timeline_PreviewMouseUp" ValueChanged="Timeline_ValueChanged"/>
                <Canvas x:Name="canvasAbMarkersFS" IsHitTestVisible="False" VerticalAlignment="Stretch" Margin="0"/>
            </Grid>
            <Grid Grid.Row="2" Margin="16,0,28,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnOpenFS" Content="{Binding [OpenFile], Source={x:Static i18n:I18nService.Instance}}" ToolTip="{Binding [TooltipOpen], Source={x:Static i18n:I18nService.Instance}}" Style="{StaticResource OpenBtn}" Click="BtnOpen_Click" ContextMenuService.IsEnabled="False" Margin="0,0,16,0">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource SmartFillContextMenuStyle}">
                                <MenuItem x:Name="menuBtnOpenFileFS" Header="{Binding [MenuOpenFile], Source={x:Static i18n:I18nService.Instance}}" Click="MenuOpenFile_Click" Style="{StaticResource SmartFillMenuItemStyle}"/>
                                <MenuItem x:Name="menuBtnOpenFolderFS" Header="{Binding [MenuOpenFolder], Source={x:Static i18n:I18nService.Instance}}" Click="MenuOpenFolder_Click" Style="{StaticResource SmartFillMenuItemStyle}"/>
                                <MenuItem x:Name="menuBtnOpenUrlFS" Header="{Binding [MenuOpenUrl], Source={x:Static i18n:I18nService.Instance}}" Click="MenuOpenUrl_Click" Style="{StaticResource SmartFillMenuItemStyle}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="btnLibraryFS" Content="&#xE1D3;" ToolTip="{Binding [TooltipLibrary], Source={x:Static i18n:I18nService.Instance}}" FontFamily="Segoe MDL2 Assets" Style="{StaticResource TransportBtn}" FontSize="20" Click="BtnLibrary_Click" Margin="0,0,10,0"/>
                    <Button x:Name="btnPrevFS" Content="&#xE100;" ToolTip="{Binding [TooltipPrev], Source={x:Static i18n:I18nService.Instance}}" Style="{StaticResource TransportBtn}" Click="BtnPrev_Click" Margin="0,0,4,0"/>
                    <Button x:Name="btnPlayFS" Content="&#xE102;" ToolTip="{Binding [TooltipPlay], Source={x:Static i18n:I18nService.Instance}}" Style="{StaticResource PlayBtn}" Click="BtnPlay_Click" Margin="2,0"/>
                    <Button x:Name="btnNextFS" Content="&#xE101;" ToolTip="{Binding [TooltipNext], Source={x:Static i18n:I18nService.Instance}}" Style="{StaticResource TransportBtn}" Click="BtnNext_Click" Margin="2,0,14,0"/>
                    <TextBlock x:Name="txtTimeFS" Text="--:-- / --:--" Foreground="{DynamicResource ThemeTextBrush}" FontFamily="Consolas, Segoe UI, Microsoft YaHei, sans-serif" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnScreenshotFS" Content="&#xE722;" ToolTip="{Binding [TooltipScreenshot], Source={x:Static i18n:I18nService.Instance}}" Style="{StaticResource TransportBtn}" Click="BtnScreenshot_Click" Margin="0,0,10,0"/>
                    <Button x:Name="btnSpeedFS" Content="1.0x" ToolTip="{Binding [TooltipSpeed], Source={x:Static i18n:I18nService.Instance}}" Style="{StaticResource TransportBtn}" Width="62" Height="42" FontFamily="Consolas, Segoe UI, Microsoft YaHei, sans-serif" Click="BtnSpeed_Click" FontSize="17" FontWeight="Bold" Margin="0,0,10,0">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource SmartFillContextMenuStyle}">
                                <MenuItem Header="0.25x" Tag="0.25" Click="SpeedMenuItem_Click" Style="{StaticResource SmartFillMenuItemStyle}"/>
                                <MenuItem Header="0.5x" Tag="0.5" Click="SpeedMenuItem_Click" Style="{StaticResource SmartFillMenuItemStyle}"/>
                                <MenuItem Header="0.75x" Tag="0.75" Click="SpeedMenuItem_Click" Style="{StaticResource SmartFillMenuItemStyle}"/>
                                <MenuItem Header="1.0x (Normal)" Tag="1.0" Click="SpeedMenuItem_Click" Style="{StaticResource SmartFillMenuItemStyle}"/>
                                <MenuItem Header="1.25x" Tag="1.25" Click="SpeedMenuItem_Click" Style="{StaticResource SmartFillMenuItemStyle}"/>
                                <MenuItem Header="1.5x" Tag="1.5" Click="SpeedMenuItem_Click" Style="{StaticResource SmartFillMenuItemStyle}"/>
                                <MenuItem Header="2.0x" Tag="2.0" Click="SpeedMenuItem_Click" Style="{StaticResource SmartFillMenuItemStyle}"/>
                                <MenuItem Header="3.0x" Tag="3.0" Click="SpeedMenuItem_Click" Style="{StaticResource SmartFillMenuItemStyle}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="btnPipFS" Content="&#xE8A7;" ToolTip="{Binding [TooltipPip], Source={x:Static i18n:I18nService.Instance}}" Style="{StaticResource TransportBtn}" Click="BtnPip_Click" Margin="0,0,10,0"/>
                    <Button x:Name="btnToggleTransitionFS" Visibility="Collapsed" Content="&#xE8B1;" ToolTip="转场动画: 关" Foreground="#666666" Style="{StaticResource TransportBtn}" Click="BtnToggleTransition_Click" Margin="0,0,16,0"/>
                    <Button x:Name="btnSmartFillFS" Content="&#xE74C;" ToolTip="{Binding [TooltipSmartFill], Source={x:Static i18n:I18nService.Instance}}" Style="{StaticResource TransportBtn}" Click="BtnSmartFill_Click" Margin="0,0,10,0">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource SmartFillContextMenuStyle}">
                                <MenuItem x:Name="menuFillNoneFS" Header="{Binding [SmartFillOff], Source={x:Static i18n:I18nService.Instance}}" Tag="none" Click="SmartFillMenuItem_Click" IsCheckable="True" IsChecked="True" Style="{StaticResource SmartFillMenuItemStyle}"/>
                                <MenuItem x:Name="menuFillNormalFS" Header="{Binding [SmartFillNormal], Source={x:Static i18n:I18nService.Instance}}" Tag="normal" Click="SmartFillMenuItem_Click" IsCheckable="True" Style="{StaticResource SmartFillMenuItemStyle}"/>
                                <MenuItem x:Name="menuFillFeatherFS" Header="{Binding [SmartFillFeather], Source={x:Static i18n:I18nService.Instance}}" Tag="feather" Click="SmartFillMenuItem_Click" IsCheckable="True" Style="{StaticResource SmartFillMenuItemStyle}"/>
                            </ContextMenu>
