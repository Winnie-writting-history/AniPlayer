                    <Button x:Name="btnTracksFS" ToolTip="{Binding [ToolTipTracks], Source={x:Static i18n:I18nService.Instance}}" Style="{StaticResource TransportBtn}" Click="BtnTracks_Click" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8BD;" Margin="0,2.5,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
