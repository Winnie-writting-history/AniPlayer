<UserControl x:Class="AnniPlayer.Views.SponsorOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:AnniPlayer.Services"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="850"
             Focusable="True"
             IsVisibleChanged="UserControl_IsVisibleChanged">
    <Grid>
        <!-- Dark backdrop -->
        <Border Background="#B3000000" MouseDown="Backdrop_MouseDown"/>

        <!-- Centered Card -->
        <Border x:Name="cardBorder" Width="540" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource ThemeWindowBgBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ThemePanelCornerRadius}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.75" ShadowDepth="10"/>
            </Border.Effect>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Header -->
                    <RowDefinition Height="Auto"/> <!-- 1: Description -->
                    <RowDefinition Height="Auto"/> <!-- 2: Network Tabs -->
                    <RowDefinition Height="Auto"/> <!-- 3: QR Code & Address -->
                    <RowDefinition Height="Auto"/> <!-- 4: Warning Note -->
                    <RowDefinition Height="Auto"/> <!-- 5: Footer Actions -->
                </Grid.RowDefinitions>

                <!-- Row 0: Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💖" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTitle" Text="捐助与支持安妮播放器" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnClose" Click="BtnClose_Click" HorizontalAlignment="Right" Width="32" Height="32"
                            Style="{StaticResource ChromeBtn}" Content="&#xE711;" ToolTip="关闭 (Esc)"/>
                </Grid>

                <!-- Row 1: Description -->
                <Border Grid.Row="1" Background="#18FFFFFF" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                    <TextBlock x:Name="txtDescription"
                               Text="本软件完全免费供大家使用，无需支付任何费用。赞助打赏虽非强制，但您的每一份支持都弥足珍贵与深受感激！"
                               FontSize="13" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextBrush}" Opacity="0.9"/>
                </Border>

                <!-- Row 2: Dynamic Network Selector Tabs -->
                <StackPanel x:Name="panelNetworkTabs" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16"/>

                <!-- Row 3: QR Code & Address Display Box -->
                <Border Grid.Row="3" Background="#10FFFFFF" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- QR Code with white frame for maximum scanner readability -->
                        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="8" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#000000" Opacity="0.3" ShadowDepth="2"/>
                            </Border.Effect>
                            <Image x:Name="imgQrCode" Width="140" Height="140" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>

                        <!-- Address & Copy button -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="收款钱包地址 (Wallet Address):" FontSize="13" Foreground="#B0C4DE" Margin="0,0,0,6"/>
                            
                            <Border Background="#20000000" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <TextBox x:Name="txtAddress" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource ThemeAccentBrush}" FontSize="13" FontWeight="Bold"
                                         FontFamily="Consolas, Cascadia Code, Courier New" TextWrapping="Wrap"/>
                            </Border>

                            <Button x:Name="btnCopy" Click="BtnCopy_Click" Height="36"
                                    Background="{DynamicResource ThemePrimaryBtnBrush}" Foreground="White" FontWeight="Bold" FontSize="14"
                                    Cursor="Hand" Style="{StaticResource ThemeButtonStyle}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📋" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="一键复制地址" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Copy feedback notification text -->
                            <TextBlock x:Name="txtCopyToast" Text="✅ 钱包地址已成功复制到剪贴板！"
                                       Foreground="#00FF7F" FontSize="12" FontWeight="Bold" Margin="0,6,0,0"
                                       HorizontalAlignment="Center" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 4: Network Warning Note -->
                <Border Grid.Row="4" Background="#26FFB800" BorderBrush="#80FFB800" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtNetworkNote" Text="请务必通过对应网络转账，转错网络资产将无法找回。"
                                   FontSize="12" Foreground="#FFE699" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Row 5: Footer Actions -->
                <Grid Grid.Row="5">
                    <Button x:Name="btnWebsite" Click="BtnWebsite_Click" HorizontalAlignment="Left" Style="{StaticResource ThemeButtonStyle}" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="访问官方主页 / 更多支持方式 →" FontSize="13" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="BtnClose_Click" HorizontalAlignment="Right" Width="90" Height="34"
                            Content="关闭" Style="{StaticResource ThemeButtonStyle}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
