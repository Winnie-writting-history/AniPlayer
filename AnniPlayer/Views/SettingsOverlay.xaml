<UserControl x:Class="AnniPlayer.Views.SettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:AnniPlayer.Services"
             mc:Ignorable="d" 
             d:DesignHeight="560" d:DesignWidth="780">
    <UserControl.Resources>
        <!-- 🎨 Theme-Adaptive Category Tab Button Style -->
        <Style x:Key="CategoryTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="10,0">
                            <Grid>
                                <!-- Selected Indicator Strip -->
                                <Border x:Name="indicator" Width="4" HorizontalAlignment="Left" CornerRadius="2"
                                        Background="{DynamicResource ThemeAccentBrush}" Visibility="Collapsed"/>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeSelectedItemBgBrush}"/>
                                <Setter TargetName="indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 🎨 Theme-Adaptive ComboBox Style -->
        <Style x:Key="ThemeComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeWindowBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid">
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" CornerRadius="6"
                                                Background="{DynamicResource ThemeWindowBgBrush}"
                                                BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" Data="M 0,0 L 4,4 L 8,0 Z" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Fill="{DynamicResource ThemeTextBrush}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" PopupAnimation="Slide" StaysOpen="False">
                                <Border x:Name="DropDownBorder" CornerRadius="6" Margin="0,4,0,0"
                                        Background="{DynamicResource ThemeWindowBgBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}">
                                    <ScrollViewer Margin="4" MaxHeight="220" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 🎨 Theme-Adaptive TextBox Style -->
        <Style x:Key="ThemeTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeWindowBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 🎨 Theme-Adaptive Action Button Style -->
        <Style x:Key="ThemeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ThemeButtonBorderThickness}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="{DynamicResource ThemeButtonCornerRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeSelectedItemBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 🎨 Theme-Adaptive Primary Action Button Style -->
        <Style x:Key="ThemePrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemePrimaryBtnBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ThemeButtonBorderThickness}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="{DynamicResource ThemeButtonCornerRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 🎨 Auto Text Wrapping for CheckBox & RadioButton in Settings Panels -->
        <Style TargetType="CheckBox">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent" x:Name="OverlayBackground">
        <!-- Center Settings Dialog Card (ClipToBounds removed to prevent border clipping; 560px height fits any fullscreen resolution) -->
        <Border Width="880" Height="570" CornerRadius="{DynamicResource ThemePanelCornerRadius}"
                Background="{DynamicResource ThemeWindowBgBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="{DynamicResource ThemeBorderThickness}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.5"/>
            </Border.Effect>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- TitleBar -->
                    <RowDefinition Height="*"/>    <!-- Main Split View -->
                    <RowDefinition Height="Auto"/> <!-- Bottom Buttons -->
                </Grid.RowDefinitions>

                    <!-- Header Title Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsTitle]}"
                                       FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}"/>
                        </StackPanel>
                        <Button x:Name="BtnClose" Click="BtnClose_Click" HorizontalAlignment="Right" Width="32" Height="32"
                                Style="{StaticResource ChromeBtn}" Content="&#xE711;"
                                ToolTip="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsBtnCancel]}"/>
                    </Grid>

                    <!-- Main Content Split: Left Category Tabs + Right Settings Content -->
                    <Grid Grid.Row="1" Margin="0,4,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="215"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                    <!-- Left Categories Panel -->
                    <StackPanel Grid.Column="0">
                        <RadioButton x:Name="TabGeneral" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsTabGeneral]}"
                                     IsChecked="True" Checked="Tab_Checked" Style="{StaticResource CategoryTabButtonStyle}"/>
                        <RadioButton x:Name="TabHotkeys" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsTabHotkeys]}"
                                     Checked="Tab_Checked" Style="{StaticResource CategoryTabButtonStyle}"/>
                        <RadioButton x:Name="TabPlayback" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsTabPlayback]}"
                                     Checked="Tab_Checked" Style="{StaticResource CategoryTabButtonStyle}"/>
                        <RadioButton x:Name="TabSlideshow" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsTabSlideshow]}"
                                     Checked="Tab_Checked" Style="{StaticResource CategoryTabButtonStyle}"/>
                        <RadioButton x:Name="TabCrop" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsTabCrop]}"
                                     Checked="Tab_Checked" Style="{StaticResource CategoryTabButtonStyle}" Visibility="Collapsed"/>
                        <RadioButton x:Name="TabAppearance" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsTabAppearance]}"
                                     Checked="Tab_Checked" Style="{StaticResource CategoryTabButtonStyle}"/>
                        <RadioButton x:Name="TabAssociations" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsTabAssociations]}"
                                     Checked="Tab_Checked" Style="{StaticResource CategoryTabButtonStyle}"/>
                        <RadioButton x:Name="TabAbout" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsTabAbout]}"
                                     Checked="Tab_Checked" Style="{StaticResource CategoryTabButtonStyle}"/>
                    </StackPanel>

                    <!-- Vertical Separator Line -->
                    <Rectangle Grid.Column="1" Fill="{DynamicResource ThemeBorderBrush}" Width="1" HorizontalAlignment="Center"/>

                    <!-- Right Tab Pages Container (Enlarged FontSize=16, Auto Text Wrapping) -->
                    <Grid Grid.Column="2">
                        <!-- Panel 1: General Settings -->
                        <ScrollViewer x:Name="PanelGeneral" Visibility="Visible" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="8,0">

                                <CheckBox x:Name="CbAutoResume" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsAutoResume]}"
                                          IsChecked="True" FontSize="16" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,8"/>
                                <CheckBox x:Name="CbAlwaysOnTop" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsAlwaysOnTop]}"
                                          FontSize="16" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,8"/>
                                <CheckBox x:Name="CbRightEdgeHoverPlaylist" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsRightEdgeHoverPlaylist]}"
                                          IsChecked="True" FontSize="16" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,8"/>
                                <CheckBox x:Name="CbDoubleEscToExit" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsDoubleEscToExit]}"
                                          IsChecked="True" FontSize="16" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,8"/>
                                <CheckBox x:Name="CbClearPlaylistOnExit" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsClearPlaylistOnExit]}"
                                          FontSize="16" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,8"/>

                                <Separator Margin="0,18" Background="{DynamicResource ThemeBorderBrush}"/>

                                <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsScreenshotPath]}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,10"/>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtScreenshotPath" Grid.Column="0" FontSize="15" Style="{StaticResource ThemeTextBoxStyle}" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnBrowseScreenshot" Grid.Column="1" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsBtnBrowse]}" Click="BtnBrowseScreenshotPath_Click" Style="{StaticResource ThemeButtonStyle}" Width="90" Height="32"/>
                                </Grid>
                                <CheckBox x:Name="ChkSaveScreenshotToFile" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsSaveScreenshotToFile]}" IsChecked="True" Click="ChkSaveScreenshotToFile_Click" FontSize="15" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,10,0,4"/>
                                <CheckBox x:Name="ChkSaveScreenshotToMediaDir" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsSaveScreenshotToMediaDir]}" IsChecked="False" Click="ChkSaveScreenshotToMediaDir_Click" FontSize="15" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,4"/>
                                <CheckBox x:Name="ChkCopyScreenshotToClipboard" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsCopyScreenshotToClipboard]}" IsChecked="False" FontSize="15" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,4"/>

                                <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsContextMenuScale]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,18,0,8"/>
                                <ComboBox x:Name="ComboContextMenuScale" Style="{StaticResource ThemeComboBoxStyle}" Width="240" HorizontalAlignment="Left" Height="36">
                                    <ComboBoxItem Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[Scale100]}" Tag="1.0"/>
                                    <ComboBoxItem Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[Scale125]}" Tag="1.25"/>
                                    <ComboBoxItem Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[Scale150]}" Tag="1.5"/>
                                </ComboBox>

                                <Separator Margin="0,18" Background="{DynamicResource ThemeBorderBrush}"/>

                                <WrapPanel Margin="0,4">
                                    <Button x:Name="BtnOpenConfigDir" Click="BtnOpenConfigDir_Click" Style="{StaticResource ThemeButtonStyle}" Padding="12,6" Margin="0,0,10,10" Height="34" FontSize="14">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📂 " FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsBtnOpenConfigDir]}" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnOpenScreenshotDir" Click="BtnOpenScreenshotDir_Click" Style="{StaticResource ThemeButtonStyle}" Padding="12,6" Margin="0,0,10,10" Height="34" FontSize="14">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📂 " FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsBtnOpenScreenshotDir]}" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnOpenLibrary" Click="BtnOpenLibrary_Click" Style="{StaticResource ThemeButtonStyle}" Padding="12,6" Margin="0,0,10,10" Height="34" FontSize="14">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📚 " FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsBtnOpenLibrary]}" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Panel 2: Hotkeys Settings -->
                        <ScrollViewer x:Name="PanelHotkeys" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="8,0">
                                <Grid Margin="0,4,0,12">
                                    <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsHotkeysTitle]}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnRestoreDefaultHotkeys" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsBtnRestoreDefaults]}" HorizontalAlignment="Right" Style="{StaticResource ThemeButtonStyle}" Padding="14,6" MinWidth="100" Height="34" FontSize="14" FontWeight="SemiBold" Click="BtnRestoreDefaultHotkeys_Click" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[HotkeyHeaderAction]}" FontSize="13" FontWeight="SemiBold" Foreground="#88FFFFFF" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[HotkeyHeaderPrimary]}" FontSize="13" FontWeight="SemiBold" Foreground="#88FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[HotkeyHeaderSecondary]}" FontSize="13" FontWeight="SemiBold" Foreground="#88FFFFFF" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[HotkeyPlayPause]}" FontSize="15" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnKey_PlayPause" Grid.Column="1" Tag="PlayPause" Click="HotkeyButton_Click" Style="{StaticResource ThemeButtonStyle}" Height="34" FontSize="14" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnKey_SecPlayPause" Grid.Column="2" Tag="SecPlayPause" Click="HotkeyButton_Click" Style="{StaticResource ThemeButtonStyle}" Height="34" FontSize="14" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[HotkeySeekForward]}" FontSize="15" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnKey_SeekForward" Grid.Column="1" Tag="SeekForward" Click="HotkeyButton_Click" Style="{StaticResource ThemeButtonStyle}" Height="34" FontSize="14" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnKey_SecSeekForward" Grid.Column="2" Tag="SecSeekForward" Click="HotkeyButton_Click" Style="{StaticResource ThemeButtonStyle}" Height="34" FontSize="14" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[HotkeySeekBackward]}" FontSize="15" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnKey_SeekBackward" Grid.Column="1" Tag="SeekBackward" Click="HotkeyButton_Click" Style="{StaticResource ThemeButtonStyle}" Height="34" FontSize="14" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnKey_SecSeekBackward" Grid.Column="2" Tag="SecSeekBackward" Click="HotkeyButton_Click" Style="{StaticResource ThemeButtonStyle}" Height="34" FontSize="14" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[HotkeySeekForward30]}" FontSize="15" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnKey_SeekForward30" Grid.Column="1" Tag="SeekForward30" Click="HotkeyButton_Click" Style="{StaticResource ThemeButtonStyle}" Height="34" FontSize="14" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnKey_SecSeekForward30" Grid.Column="2" Tag="SecSeekForward30" Click="HotkeyButton_Click" Style="{StaticResource ThemeButtonStyle}" Height="34" FontSize="14" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[HotkeySeekBackward30]}" FontSize="15" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnKey_SeekBackward30" Grid.Column="1" Tag="SeekBackward30" Click="HotkeyButton_Click" Style="{StaticResource ThemeButtonStyle}" Height="34" FontSize="14" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnKey_SecSeekBackward30" Grid.Column="2" Tag="SecSeekBackward30" Click="HotkeyButton_Click" Style="{StaticResource ThemeButtonStyle}" Height="34" FontSize="14" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[HotkeySpeedUp]}" FontSize="15" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnKey_SpeedUp" Grid.Column="1" Tag="SpeedUp" Click="HotkeyButton_Click" Style="{StaticResource ThemeButtonStyle}" Height="34" FontSize="14" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnKey_SecSpeedUp" Grid.Column="2" Tag="SecSpeedUp" Click="HotkeyButton_Click" Style="{StaticResource ThemeButtonStyle}" Height="34" FontSize="14" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[HotkeySpeedDown]}" FontSize="15" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnKey_SpeedDown" Grid.Column="1" Tag="SpeedDown" Click="HotkeyButton_Click" Style="{StaticResource ThemeButtonStyle}" Height="34" FontSize="14" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnKey_SecSpeedDown" Grid.Column="2" Tag="SecSpeedDown" Click="HotkeyButton_Click" Style="{StaticResource ThemeButtonStyle}" Height="34" FontSize="14" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[HotkeyVolumeUp]}" FontSize="15" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center"/>
