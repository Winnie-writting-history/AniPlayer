                                             GroupName="SmartFillMode" FontSize="16" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,6"/>
                                <RadioButton x:Name="RbSmartFillFeather" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsSmartFillFeather]}"
                                             GroupName="SmartFillMode" FontSize="16" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,6"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Panel 5: Language & Appearance -->
                        <ScrollViewer x:Name="PanelAppearance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="8,0">
                                <!-- 1. Language -->
                                <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsLanguage]}"
                                           FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,10"/>
                                <ComboBox x:Name="ComboLanguage" Width="320" HorizontalAlignment="Left" Style="{StaticResource ThemeComboBoxStyle}" SelectionChanged="ComboLanguage_SelectionChanged"/>

                                <Separator Margin="0,18" Background="{DynamicResource ThemeBorderBrush}"/>

                                <!-- 2. Custom Skins (Highest priority, overrides Theme) -->
                                <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsSkinTitle]}"
                                           FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,8"/>
                                <ComboBox x:Name="ComboSkin" Width="380" HorizontalAlignment="Left" Style="{StaticResource ThemeComboBoxStyle}" SelectionChanged="ComboSkin_SelectionChanged"/>
                                
                                <TextBlock x:Name="TxtSkinStatus" Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsSkinActiveHint]}"
                                           FontSize="13" Foreground="{DynamicResource ThemeSubTextBrush}" Margin="0,6,0,12" TextWrapping="Wrap"/>

                                <Grid Margin="0,4,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Row 0: Import Skin & Open Skins Folder -->
                                    <Button x:Name="BtnImportSkin" Grid.Row="0" Grid.Column="0" Click="BtnImportSkin_Click"
                                            Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsImportSkin]}"
                                            Style="{StaticResource ThemeButtonStyle}" FontSize="13" Padding="12,6" Margin="0,0,10,10"/>
                                    <Button x:Name="BtnOpenSkinsFolder" Grid.Row="0" Grid.Column="1" Click="BtnOpenSkinsFolder_Click"
                                            Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsOpenSkinsFolder]}"
                                            Style="{StaticResource ThemeButtonStyle}" FontSize="13" Padding="12,6" Margin="0,0,10,10"/>

                                    <!-- Row 1: Export Skin Template (Below Import) & Refresh Skins -->
                                    <Button x:Name="BtnExportSkinXaml" Grid.Row="1" Grid.Column="0" Click="BtnExportSkinXaml_Click"
                                            Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsExportSkinXaml]}"
                                            Style="{StaticResource ThemeButtonStyle}" FontSize="13" Padding="12,6" Margin="0,0,10,10"/>
                                    <Button x:Name="BtnRefreshSkins" Grid.Row="1" Grid.Column="1" Click="BtnRefreshSkins_Click"
                                            Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsRefreshSkins]}"
                                            Style="{StaticResource ThemeButtonStyle}" FontSize="13" Padding="12,6" Margin="0,0,10,10"/>
                                </Grid>

                                <Separator Margin="0,18" Background="{DynamicResource ThemeBorderBrush}"/>

                                <!-- 3. Built-in Theme Palettes (Active when no skin is loaded) -->
                                <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsThemeTitle]}"
                                           FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,4"/>
                                <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsThemeDesc]}"
                                           FontSize="13" Foreground="{DynamicResource ThemeSubTextBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <ComboBox x:Name="ComboTheme" Width="380" HorizontalAlignment="Left" Style="{StaticResource ThemeComboBoxStyle}" SelectionChanged="ComboTheme_SelectionChanged"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Panel 6: File Associations -->
                        <ScrollViewer x:Name="PanelAssociations" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="8,0">
                                <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsAssociationsTitle]}"
                                           FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,10"/>
                                <CheckBox x:Name="CbAssociateVideos" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsAssociateVideos]}"
                                          FontSize="15" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,10"/>
                                <CheckBox x:Name="CbAssociateAudios" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsAssociateAudios]}"
                                          FontSize="15" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,10"/>
                                <CheckBox x:Name="CbAssociateFolderContextMenu" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsAssociateFolder]}"
                                          FontSize="15" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,10"/>

                                <Separator Margin="0,18" Background="{DynamicResource ThemeBorderBrush}"/>

                                <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsShortcutsTitle]}"
                                           FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,10"/>
                                <CheckBox x:Name="CbDesktopShortcut" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsDesktopShortcut]}"
                                          FontSize="15" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,10"/>
                                <CheckBox x:Name="CbStartMenuShortcut" Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsStartMenuShortcut]}"
                                          FontSize="15" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,10"/>
                                
                                <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsSystemDefaultTitle]}"
                                           FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,10"/>
                                <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsSystemDefaultDesc]}"
                                           FontSize="14" Foreground="{DynamicResource ThemeTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.8"/>
                                <Button x:Name="BtnOpenSysDefaults" Click="BtnOpenSysDefaults_Click" HorizontalAlignment="Left"
                                        Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsBtnOpenSysDefaults]}"
                                        Style="{StaticResource ThemeButtonStyle}" FontSize="14" Padding="16,8"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Panel 8: About & License -->
                        <ScrollViewer x:Name="PanelAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="8,0">
                                <!-- Logo & App Info -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                                    <Image Source="pack://application:,,,/Assets/app_icon.png" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Anni Player" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}"/>
                                        <TextBlock Text="v1.0.0 (Pure Native WPF .NET 8 Edition)" FontSize="13" Foreground="#99FFFFFF" Margin="0,3,0,0"/>
                                        <TextBlock Text="Powered by libmpv &amp; FFmpeg" FontSize="13" Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Separator Margin="0,0,0,16" Background="{DynamicResource ThemeBorderBrush}"/>

                                <!-- 💖 Sponsor / Donate Banner -->
                                <Border Background="#1C00F0FF" BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[AboutSponsorBannerTitle]}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}"/>
                                            <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[AboutSponsorBannerDesc]}" FontSize="12" Foreground="#AAFFFFFF" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="BtnOpenSponsor" Click="BtnOpenSponsor_Click" Height="36" Padding="16,6"
                                                Background="{DynamicResource ThemePrimaryBtnBrush}" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"
                                                Style="{StaticResource ThemeButtonStyle}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="💖" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[AboutBtnSponsor]}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Official Links -->
                                <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[AboutLinksTitle]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,10"/>
                                
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[AboutHomepage]}" FontSize="14" Foreground="#AAFFFFFF" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource ThemeButtonStyle}" Click="BtnOpenHomepage_Click" Height="32" Padding="10,4">
                                        <TextBlock Text="https://aniplayer.ai.studio/" Foreground="{DynamicResource ThemeAccentBrush}" FontSize="14" TextDecorations="Underline"/>
                                    </Button>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GitHub Source:" FontSize="14" Foreground="#AAFFFFFF" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource ThemeButtonStyle}" Click="BtnOpenGithub_Click" Height="32" Padding="10,4">
                                        <TextBlock Text="https://github.com/Winnie-writting-history/AniPlayer" Foreground="{DynamicResource ThemeAccentBrush}" FontSize="14" TextDecorations="Underline"/>
                                    </Button>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="YouTube Channel:" FontSize="14" Foreground="#AAFFFFFF" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource ThemeButtonStyle}" Click="BtnOpenYoutube_Click" Height="32" Padding="10,4">
                                        <TextBlock Text="https://www.youtube.com/channel/UCpq209kHbKajSEbbXjMVJZw/" Foreground="{DynamicResource ThemeAccentBrush}" FontSize="14" TextDecorations="Underline"/>
                                    </Button>
                                </Grid>

                                <Separator Margin="0,16" Background="{DynamicResource ThemeBorderBrush}"/>

                                <!-- License & Terms -->
                                <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[AboutLicenseTitle]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,8"/>
                                
                                <Border Background="#15FFFFFF" CornerRadius="8" Padding="14" Margin="0,4">
                                    <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[AboutLicenseText]}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource ThemeTextBrush}"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Bottom Actions Bar (Auto Width Buttons) -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="BtnSave" Click="BtnSave_Click" MinWidth="110" Height="38" Margin="0,0,12,0"
                            Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsBtnSave]}"
                            Style="{StaticResource ThemePrimaryButtonStyle}"/>
                    <Button x:Name="BtnCancel" Click="BtnCancel_Click" MinWidth="95" Height="38"
                            Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[SettingsBtnCancel]}"
                            FontSize="15" Style="{StaticResource ThemeButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
