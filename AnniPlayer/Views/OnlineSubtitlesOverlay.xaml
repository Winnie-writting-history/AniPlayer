<UserControl x:Class="AnniPlayer.Views.OnlineSubtitlesOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:AnniPlayer.Services"
             mc:Ignorable="d" 
             Focusable="True"
             d:DesignHeight="360" d:DesignWidth="760">
    
    <!-- Transparent Mask for ESC/Click Exit -->
    <Grid Background="#66000000" MouseDown="MaskGrid_MouseDown">
        
        <!-- Bottom Panel — 使用 ThemeDrawerBgBrush 适配主题 -->
        <Border x:Name="PanelBorder"
                CornerRadius="12,12,0,0"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1,1,1,0"
                VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                MaxHeight="380" Margin="0,0,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" Color="#000000" Opacity="0.85" ShadowDepth="8"/>
            </Border.Effect>
            
            <Grid>
                <Border Background="{DynamicResource ThemePanelImageBrush}" CornerRadius="12,12,0,0" IsHitTestVisible="False"/>
                <Border Background="{DynamicResource ThemeMenuBgBrush}" CornerRadius="12,12,0,0" IsHitTestVisible="False" Opacity="0.88"/>
                <Grid Margin="18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Search Bar -->
                    <RowDefinition Height="*"/>    <!-- Subtitle Results List -->
                    <RowDefinition Height="Auto"/> <!-- Status Bar -->
                </Grid.RowDefinitions>

                <!-- 1. Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[OnlineSubTitle]}"
                                   FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextBrush}"/>
                        <TextBlock x:Name="TxtVideoName" Text="" FontSize="11" 
                                   Foreground="{DynamicResource ThemeAccentBrush}" 
                                   Opacity="0.7"
                                   Margin="10,0,0,0" VerticalAlignment="Center" 
                                   TextTrimming="CharacterEllipsis" MaxWidth="460"/>
                    </StackPanel>
                    <!-- Top Right Close Button -->
                    <Button x:Name="BtnClose" Click="BtnClose_Click" Style="{StaticResource ChromeBtn}" 
                            Content="✕" Width="28" Height="28" HorizontalAlignment="Right" FontSize="13"/>
                </Grid>

                <!-- 2. Search Toolbar -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 搜索框：完全用主题 brush，适配各主题 -->
                    <Border Grid.Column="0" 
                            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Background="#20000000">
                        <TextBox x:Name="TxtSearchKeyword" 
                                 FontSize="13" 
                                 Foreground="{DynamicResource ThemeTextBrush}"
                                 Background="Transparent" 
                                 BorderThickness="0"
                                 Padding="10,4" Height="32" 
                                 VerticalContentAlignment="Center"
                                 CaretBrush="{DynamicResource ThemeAccentBrush}"
                                 SelectionBrush="{DynamicResource ThemeAccentBrush}"
                                 KeyDown="TxtSearchKeyword_KeyDown"/>
                    </Border>
                    <Button x:Name="BtnSearch" Click="BtnSearch_Click" Grid.Column="1" Margin="8,0,0,0"
                            Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[BtnSearch]}"
                            Style="{StaticResource ThemeButtonStyle}" Height="32" Padding="14,0" FontSize="12"/>
                    <Button x:Name="BtnSmartMatch" Click="BtnSmartMatch_Click" Grid.Column="2" Margin="8,0,0,0"
                            Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[BtnSmartMatch]}"
                            Style="{StaticResource ThemeButtonStyle}" Height="32" Padding="14,0" FontSize="12"/>
                </Grid>

                <!-- 3. Subtitle Results List -->
                <Border Grid.Row="2" CornerRadius="8" 
                        Background="#18000000" 
                        BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                    <Grid>
                        <ListBox x:Name="LstSubtitles" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 MouseDoubleClick="LstSubtitles_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="Margin" Value="2,2,2,2"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#25FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#40007ACC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type services:SubtitleSearchResult}">
                                    <Grid Height="40">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Language Badge -->
                                            <ColumnDefinition Width="*"/>    <!-- Subtitle Title & Source -->
                                            <ColumnDefinition Width="Auto"/> <!-- Format Badge & Score -->
                                            <ColumnDefinition Width="Auto"/> <!-- Download Button -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Language Badge — 用主题 accent -->
                                        <Border Grid.Column="0" CornerRadius="4" 
                                                Background="#30007ACC" 
                                                Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Language}" FontSize="11" 
                                                       Foreground="{DynamicResource ThemeAccentBrush}" 
                                                       FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Subtitle Title & Source -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource ThemeTextBrush}" 
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Source}" FontSize="10" 
                                                       Foreground="{DynamicResource ThemeTextBrush}" 
                                                       Opacity="0.5" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <!-- Format Tag & Match Rating -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                            <Border CornerRadius="4" Background="#20FFFFFF" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Format}" FontSize="10" 
                                                           Foreground="{DynamicResource ThemeTextBrush}" Opacity="0.7"/>
                                            </Border>
                                            <TextBlock Text="{Binding MatchScore, StringFormat='{}{0}% 匹配'}" 
                                                       FontSize="11" Foreground="#AAFFD700" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Action Button -->
                                        <Button Grid.Column="3" Click="BtnItemDownload_Click"
                                                Content="{Binding Source={x:Static services:I18nService.Instance}, Path=[BtnDownloadAndApply]}"
                                                Style="{StaticResource ThemeButtonStyle}" 
                                                Height="26" Padding="10,0" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty State -->
                        <TextBlock x:Name="TxtEmptyHint" 
                                   Text="{Binding Source={x:Static services:I18nService.Instance}, Path=[TxtNoResults]}"
                                   FontSize="13" Foreground="{DynamicResource ThemeTextBrush}" Opacity="0.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- 4. Status Bar -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <ProgressBar x:Name="ProgressSearching" Height="2" IsIndeterminate="True" 
                                 Visibility="Collapsed" VerticalAlignment="Top"
                                 Foreground="{DynamicResource ThemeAccentBrush}"
                                 Background="Transparent"/>
                    <TextBlock x:Name="TxtStatus" Text="" FontSize="11" 
                               Foreground="{DynamicResource ThemeTextBrush}" Opacity="0.6"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
