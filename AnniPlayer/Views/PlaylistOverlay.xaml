<UserControl x:Class="AnniPlayer.Views.PlaylistOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i18n="clr-namespace:AnniPlayer.Services"
             mc:Ignorable="d" 
             d:DesignHeight="530" d:DesignWidth="780"
             Background="Transparent">

    <Grid>
        <Border Width="780" Height="530" 
                Background="{DynamicResource ThemeDrawerBgBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="{DynamicResource ThemeBorderThickness}" CornerRadius="{DynamicResource ThemePanelCornerRadius}">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.5" Direction="270" ShadowDepth="5"/>
            </Border.Effect>
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Header -->
                <Grid>
                    <TextBlock x:Name="txtTitle" Text="{Binding [LibraryTitle], Source={x:Static i18n:I18nService.Instance}}" Foreground="{DynamicResource ThemeTextBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="btnClose" Click="BtnClose_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource ChromeBtn}" Content="&#xE711;"
                            ToolTip="{Binding Source={x:Static i18n:I18nService.Instance}, Path=[SettingsBtnCancel]}"/>
                </Grid>
                
                <!-- === VIEW: SELECTION === -->
                <Grid x:Name="viewSelection" Grid.Row="1" Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="{DynamicResource ThemeBorderThickness}" CornerRadius="8" Background="{DynamicResource ThemeMenuBgBrush}">
                        <ListBox x:Name="lbPlaylists" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource ThemeTextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 SelectionChanged="LbPlaylists_SelectionChanged" MouseDoubleClick="LbPlaylists_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#0AFFFFFF"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                             <ControlTemplate TargetType="ListBoxItem">
                                                 <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Margin="2">
                                                     <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                                 </Border>
                                                 <ControlTemplate.Triggers>
                                                     <Trigger Property="IsMouseOver" Value="True">
                                                         <Setter Property="Background" Value="#15FFFFFF"/>
                                                     </Trigger>
                                                     <Trigger Property="IsSelected" Value="True">
                                                         <Setter Property="Background" Value="{DynamicResource ThemeSelectedItemBgBrush}"/>
                                                         <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                                                         <Setter Property="FontWeight" Value="Bold"/>
                                                     </Trigger>
                                                 </ControlTemplate.Triggers>
                                             </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                    
                    <Border Grid.Column="2" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="{DynamicResource ThemeBorderThickness}" CornerRadius="8" Background="{DynamicResource ThemeMenuBgBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" Margin="10,8">
                                    <TextBlock x:Name="txtSelectedPlaylist" Text="{Binding [LibraryNoSelection], Source={x:Static i18n:I18nService.Instance}}" Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="lbFiles" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource ThemeTextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     KeyDown="LbFiles_KeyDown"
                                     MouseDoubleClick="LbFiles_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Media Type Icon (matches file name font color) -->
                                            <TextBlock Text="{Binding TypeIcon}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <!-- File Name -->
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center" ToolTip="{Binding Path}"/>
                                            <!-- File Size -->
                                            <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Foreground="{DynamicResource ThemeTextBrush}" Opacity="0.65" FontSize="11" VerticalAlignment="Center" Margin="10,0,10,0"/>
                                            <!-- Delete Button -->
                                            <Button Grid.Column="3" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                    Background="Transparent" BorderThickness="0" Foreground="#AAFF5555" Cursor="Hand"
                                                    Padding="4,2" Margin="2,0,0,0" ToolTip="{Binding Source={x:Static i18n:I18nService.Instance}, Path=[LibraryBtnDelete]}"
                                                    Click="BtnRemoveFileFromPlaylist_Click" Tag="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2,1">
                                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeSelectedItemBgBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#2000F2FE" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Border>
                    
                    <!-- Selection Footer -->
                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,15,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnLoad" Content="{Binding [LibraryBtnLoad], Source={x:Static i18n:I18nService.Instance}}" Foreground="{DynamicResource ThemeTextBrush}" FontWeight="Bold" BorderThickness="{DynamicResource ThemeButtonBorderThickness}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" Padding="16,8" Click="BtnLoad_Click" Background="{DynamicResource ThemePrimaryBtnBrush}">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="{DynamicResource ThemeButtonCornerRadius}"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="btnNew" Content="{Binding [LibraryBtnNew], Source={x:Static i18n:I18nService.Instance}}" Background="#15FFFFFF" Foreground="{DynamicResource ThemeTextBrush}" BorderThickness="{DynamicResource ThemeButtonBorderThickness}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" Padding="12,8" Margin="8,0,0,0" Click="BtnNew_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="{DynamicResource ThemeButtonCornerRadius}"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="btnEditMode" Content="{Binding [LibraryBtnEdit], Source={x:Static i18n:I18nService.Instance}}" Background="#15FFFFFF" Foreground="{DynamicResource ThemeTextBrush}" BorderThickness="{DynamicResource ThemeButtonBorderThickness}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" Padding="12,8" Margin="8,0,0,0" Click="BtnEditMode_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="{DynamicResource ThemeButtonCornerRadius}"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="btnMergeMode" Content="{Binding [LibraryBtnMerge], Source={x:Static i18n:I18nService.Instance}}" Background="#15FFFFFF" Foreground="{DynamicResource ThemeTextBrush}" BorderThickness="{DynamicResource ThemeButtonBorderThickness}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" Padding="12,8" Margin="8,0,0,0" Click="BtnMergeMode_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="{DynamicResource ThemeButtonCornerRadius}"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="btnImport" Content="{Binding [LibraryBtnImport], Source={x:Static i18n:I18nService.Instance}}" Background="#15FFFFFF" Foreground="{DynamicResource ThemeTextBrush}" BorderThickness="{DynamicResource ThemeButtonBorderThickness}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" Padding="12,8" Margin="8,0,0,0" Click="BtnImport_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="{DynamicResource ThemeButtonCornerRadius}"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="btnExport" Content="{Binding [LibraryBtnExport], Source={x:Static i18n:I18nService.Instance}}" Background="#15FFFFFF" Foreground="{DynamicResource ThemeTextBrush}" BorderThickness="{DynamicResource ThemeButtonBorderThickness}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" Padding="12,8" Margin="8,0,0,0" Click="BtnExport_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="{DynamicResource ThemeButtonCornerRadius}"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="btnDelete" Content="{Binding [LibraryBtnDelete], Source={x:Static i18n:I18nService.Instance}}" Background="#15FFFFFF" Foreground="{DynamicResource ThemeTextBrush}" BorderThickness="{DynamicResource ThemeButtonBorderThickness}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" Padding="12,8" Margin="8,0,0,0" Click="BtnDelete_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="{DynamicResource ThemeButtonCornerRadius}"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="btnClearAll" Content="{Binding [LibraryBtnClearAll], Source={x:Static i18n:I18nService.Instance}}" Background="#15FFFFFF" Foreground="{DynamicResource ThemeTextBrush}" BorderThickness="{DynamicResource ThemeButtonBorderThickness}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" Padding="12,8" Margin="8,0,0,0" Click="BtnClearAll_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="{DynamicResource ThemeButtonCornerRadius}"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- === VIEW: EDIT === -->
                <Grid x:Name="viewEdit" Grid.Row="1" Margin="0,15,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{Binding [LibraryLabelName], Source={x:Static i18n:I18nService.Instance}}" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtEditName" Width="300" Background="{DynamicResource ThemeDrawerBgBrush}" Foreground="{DynamicResource ThemeTextBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" Padding="5"/>
                    </StackPanel>
                    
                    <Border Grid.Row="1" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="{DynamicResource ThemeBorderThickness}" CornerRadius="8" Background="{DynamicResource ThemeMenuBgBrush}">
                        <ListBox x:Name="lbEditFiles" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeTextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 AllowDrop="True" DragOver="LbEditFiles_DragOver" Drop="EditFiles_Drop"
                                 PreviewMouseLeftButtonDown="LbEditFiles_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="LbEditFiles_PreviewMouseMove">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Foreground="#FF5555" Cursor="Hand" Margin="10,0,0,0" Click="BtnRemoveVideo_Click" Tag="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="2,1">
                                                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                    
                    <!-- Edit Footer -->
                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnAddVideo" Content="{Binding [LibraryBtnAddVideo], Source={x:Static i18n:I18nService.Instance}}" Background="#15FFFFFF" Foreground="{DynamicResource ThemeTextBrush}" BorderThickness="{DynamicResource ThemeButtonBorderThickness}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" Padding="16,8" Click="BtnAddVideo_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="16"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="btnAddFolder" Content="{Binding [LibraryBtnAddFolder], Source={x:Static i18n:I18nService.Instance}}" Background="#15FFFFFF" Foreground="{DynamicResource ThemeTextBrush}" BorderThickness="{DynamicResource ThemeButtonBorderThickness}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" Padding="16,8" Margin="10,0,0,0" Click="BtnAddFolder_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="16"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnCancelEdit" Content="{Binding [LibraryBtnCancel], Source={x:Static i18n:I18nService.Instance}}" Background="Transparent" Foreground="{DynamicResource ThemeTextBrush}" BorderThickness="{DynamicResource ThemeButtonBorderThickness}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" Padding="16,8" Margin="0,0,10,0" Click="BtnCancelEdit_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="{DynamicResource ThemeButtonCornerRadius}"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="btnSaveEdit" Content="{Binding [LibraryBtnSave], Source={x:Static i18n:I18nService.Instance}}" Foreground="{DynamicResource ThemeTextBrush}" FontWeight="Bold" BorderThickness="{DynamicResource ThemeButtonBorderThickness}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" Padding="20,8" Click="BtnSaveEdit_Click" Background="{DynamicResource ThemePrimaryBtnBrush}">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="{DynamicResource ThemeButtonCornerRadius}"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
                
                <!-- === VIEW: MERGE PLAYLISTS === -->
                <Grid x:Name="viewMerge" Grid.Row="1" Margin="0,15,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{Binding [LibraryLabelMergeName], Source={x:Static i18n:I18nService.Instance}}" Foreground="{DynamicResource ThemeTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtMergeName" Width="300" Background="{DynamicResource ThemeDrawerBgBrush}" Foreground="{DynamicResource ThemeTextBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" Padding="5"/>
                    </StackPanel>
                    
                    <Border Grid.Row="1" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="{DynamicResource ThemeBorderThickness}" CornerRadius="8" Background="{DynamicResource ThemeMenuBgBrush}">
                        <ListBox x:Name="lbMergePlaylists" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeTextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Foreground="{DynamicResource ThemeTextBrush}" Margin="5"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    
                    <!-- Merge Footer -->
                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnCancelMerge" Content="{Binding [LibraryBtnCancel], Source={x:Static i18n:I18nService.Instance}}" Background="Transparent" Foreground="{DynamicResource ThemeTextBrush}" BorderThickness="{DynamicResource ThemeButtonBorderThickness}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" Padding="16,8" Margin="0,0,10,0" Click="BtnCancelMerge_Click">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="{DynamicResource ThemeButtonCornerRadius}"/></Style></Button.Resources>
                            </Button>
                            <Button x:Name="btnConfirmMerge" Content="{Binding [LibraryBtnConfirmMerge], Source={x:Static i18n:I18nService.Instance}}" Foreground="{DynamicResource ThemeTextBrush}" FontWeight="Bold" BorderThickness="{DynamicResource ThemeButtonBorderThickness}" BorderBrush="{DynamicResource ThemeBorderBrush}" Cursor="Hand" Padding="20,8" Click="BtnConfirmMerge_Click" Background="{DynamicResource ThemePrimaryBtnBrush}">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="{DynamicResource ThemeButtonCornerRadius}"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>
