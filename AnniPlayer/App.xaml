<Application x:Class="AnniPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="#00E5FF"/>
        <SolidColorBrush x:Key="ThemeTextBrush" Color="#DDDDDD"/>
        <SolidColorBrush x:Key="ThemeSubTextBrush" Color="#B4C6E0"/>
        <SolidColorBrush x:Key="ThemeWindowBgBrush" Color="#051024"/>
        <SolidColorBrush x:Key="ThemeMenuBgBrush" Color="#F0051024"/>
        <SolidColorBrush x:Key="ThemeDrawerBgBrush" Color="#E6051024"/>
        <SolidColorBrush x:Key="ThemeBorderBrush" Color="#403377FF"/>
        <SolidColorBrush x:Key="ThemeMenuSeparatorBrush" Color="#30000000"/>
        <SolidColorBrush x:Key="ThemeButtonBgBrush" Color="#20FFFFFF"/>

        <!-- ══ Theme Audio Floating Banner & Vinyl Disc Dedicated Brushes ══ -->
        <SolidColorBrush x:Key="ThemeAudioBannerBgBrush" Color="#3308101C"/>
        <SolidColorBrush x:Key="ThemeAudioBannerBorderBrush" Color="#A000F0FF"/>
        <SolidColorBrush x:Key="ThemeAudioDiscBorderBrush" Color="#8000F0FF"/>
        <SolidColorBrush x:Key="ThemeAudioAccentBrush" Color="#00F0FF"/>
        <SolidColorBrush x:Key="ThemeAudioTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeAudioSubTextBrush" Color="#C0E0FF"/>

        <SolidColorBrush x:Key="ThemeButtonHoverBrush" Color="#3A4B70"/>
        <SolidColorBrush x:Key="ThemeButtonHoverFgBrush" Color="#FFFFFF"/>

        <!-- ══ Dynamic Geometry & Typography Tokens (Driven by skin.json) ══ -->
        <CornerRadius x:Key="ThemeButtonCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="ThemePanelCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="ThemeWindowCornerRadius">10</CornerRadius>
        <Thickness x:Key="ThemeBorderThickness">1</Thickness>
        <Thickness x:Key="ThemeButtonBorderThickness">1</Thickness>
        <FontFamily x:Key="ThemeFontFamily">Microsoft YaHei, Segoe UI, sans-serif</FontFamily>
        <sys:Double x:Key="ThemeFontSizeBase">14</sys:Double>
        
        <LinearGradientBrush x:Key="ThemeTitleBarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#D90E2C5A" Offset="0"/>
            <GradientStop Color="#E6081B38" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ThemeControlBarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6081B38" Offset="0"/>
            <GradientStop Color="#F2051024" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ThemePrimaryBtnBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0072FF" Offset="0"/>
            <GradientStop Color="#00F2FE" Offset="1"/>
        </LinearGradientBrush>

        <!-- ══ Brushed Metal Micro-Stripe Texture ══ -->
        <DrawingBrush x:Key="BrushedMetalTextureBrush" TileMode="Tile" Viewport="0,0,12,3" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#0BFFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,12,1"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#0D000000">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,1.5,12,1"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- ══ Chrome Buttons ══ -->
        <Style x:Key="ChromeBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ThemeButtonCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource ThemeButtonHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeButtonHoverFgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1C2942"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 🎨 Theme-Adaptive Button Style -->
        <Style x:Key="ThemeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeButtonHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ThemeButtonBorderThickness}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="{DynamicResource ThemeButtonCornerRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeSelectedItemBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 🎨 Theme Tab Button Style for RadioButtons -->
        <Style x:Key="ThemeTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="{DynamicResource ThemeButtonCornerRadius}" Background="{TemplateBinding Background}" Padding="10,0"
                                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="{DynamicResource ThemeButtonBorderThickness}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeSelectedItemBgBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 🎨 Theme Action Button Style matching Tab RadioButton -->
        <Style x:Key="ThemeTabActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="{DynamicResource ThemeButtonCornerRadius}" Background="{TemplateBinding Background}" Padding="10,0"
                                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="{DynamicResource ThemeButtonBorderThickness}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeButtonHoverBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeSelectedItemBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 🎨 Theme Primary Action Button Style -->
        <Style x:Key="ThemePrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ThemePrimaryBtnBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ThemeButtonBorderThickness}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="{DynamicResource ThemeButtonCornerRadius}" Background="{TemplateBinding Background}" Padding="12,0"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 🎨 Theme-Adaptive TextBox Style -->
        <Style x:Key="ThemeTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeWindowBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource ThemeBorderThickness}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="{DynamicResource ThemeButtonCornerRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 🎨 Theme-Adaptive Universal ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="14"/>
                    <Setter Property="MinWidth" Value="14"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent" Margin="0,4">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb x:Name="Thumb">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border x:Name="thumbBorder"
                                                                Background="{DynamicResource ThemeScrollBarThumbBrush}"
                                                                CornerRadius="5" Margin="2,1"
                                                                SnapsToDevicePixels="True"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ThemeScrollBarThumbHoverBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ThemeScrollBarThumbPressedBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="14"/>
                    <Setter Property="MinHeight" Value="14"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent" Margin="4,0">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb x:Name="Thumb">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border x:Name="thumbBorder"
                                                                Background="{DynamicResource ThemeScrollBarThumbBrush}"
                                                                CornerRadius="5" Margin="1,2"
                                                                SnapsToDevicePixels="True"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ThemeScrollBarThumbHoverBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ThemeScrollBarThumbPressedBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
